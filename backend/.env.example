# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://csc_user:change-me@localhost:3306/csc_credits"

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=4000

# Origin(s) of the frontend, comma-separated. Used for CORS and inside QR codes.
FRONTEND_URL="http://localhost:5173"

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@csc.local"
SEED_ADMIN_PASSWORD="change-this-admin-password"
SEED_ADMIN_NAME="CSC Admin"

# Email for "Forgot password" (optional).
# Leave SMTP_HOST empty in development: reset emails are then printed in the backend terminal.
# Gmail example: SMTP_HOST="smtp.gmail.com" SMTP_PORT=465 SMTP_USER="you@gmail.com" SMTP_PASS="<16-char app password>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CSC Credits <no-reply@csc.local>"
